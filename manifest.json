{
  "manifest_version": 3,
  "name": "Focus Monitor",
  "version": "1.0.0",
  "description": "Stay focused with a timer and a private view of your website time.",
  "permissions": ["alarms", "idle", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Focus Monitor",
    "default_popup": "popup.html"
  }
}
